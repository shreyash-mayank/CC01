# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/community-platform

# JWT Secret (generate random 32+ character string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars

# Server
PORT=5000
NODE_ENV=production

# Client URL (update with your frontend domain)
CLIENT_URL=https://yourdomain.com

# Optional: For production logging
LOG_LEVEL=info
